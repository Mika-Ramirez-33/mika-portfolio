---

<section
  id="expertise"
  class="skills-section"
>
  <header class="skills-header">

    <div>
      <p class="section-eyebrow">
        {t('skills.eyebrow')}
      </p>

      <h2 class="section-title">
        {t('skills.title')}
      </h2>
    </div>

    <p class="section-description">
      {t('skills.description')}
    </p>

  </header>

  <div class="skills-grid">
    {
      skillCategories.map((category) => (

        <article
          class:list={[
            'skill-card',
            category.featured &&
              'skill-card-featured',
          ]}
        >

          <div class="skill-card-header">

            <span class="category-number">
              {category.number}
            </span>

            <div>

              <h3 class="category-title">
                {t(category.titleKey)}
              </h3>

              <p class="category-description">
                {t(category.descriptionKey)}
              </p>

            </div>

          </div>

          <div class="skill-groups">
            {
              category.groups.map((group) => (

                <div class="skill-group">

                  {
                    (group.titleKey || group.title) && (
                      <p class="group-title">
                        {
                          group.titleKey
                            ? t(group.titleKey)
                            : group.title
                        }
                      </p>
                    )
                  }

                  <div class="skill-tags">
                    {
                      group.skills.map((skill) => (

                        <span class="skill-tag">
                          {
                            skill.key
                              ? t(skill.key)
                              : skill.name
                          }
                        </span>

                      ))
                    }
                  </div>

                </div>

              ))
            }
          </div>

        </article>

      ))
    }
  </div>
</section>

<style>
  .skills-section {
    padding: 2rem;

    border:
      1px solid
      var(--border-color);

    border-radius:
      2rem;

    background:
      var(--background-elevated);

    box-shadow:
      0 20px 50px
      var(--shadow-color);

    backdrop-filter:
      blur(18px);

    -webkit-backdrop-filter:
      blur(18px);
  }

  .skills-header {
    display:
      flex;

    align-items:
      flex-end;

    justify-content:
      space-between;

    gap:
      2rem;

    margin-bottom:
      2rem;
  }

  .section-eyebrow {
    margin:
      0;

    color:
      var(--accent);

    font-size:
      0.78rem;

    font-weight:
      650;

    letter-spacing:
      0.18em;

    text-transform:
      uppercase;
  }

  .section-title {
    margin:
      0.35rem 0 0;

    color:
      var(--text-primary);

    font-size:
      clamp(
        1.8rem,
        3vw,
        2.4rem
      );

    font-weight:
      720;

    letter-spacing:
      -0.035em;
  }

  .section-description {
    max-width:
      38rem;

    margin:
      0;

    color:
      var(--text-secondary);

    font-size:
      0.92rem;

    line-height:
      1.55rem;
  }

  .skills-grid {
    display:
      grid;

    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );

    gap:
      1rem;
  }

  .skill-card {
    position:
      relative;

    padding:
      1.4rem;

    border:
      1px solid
      var(--border-color);

    border-radius:
      1.4rem;

    background:
      var(--background-secondary);

    overflow:
      hidden;

    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease,
      background-color 180ms ease;
  }

  .skill-card:hover {
    transform:
      translateY(-3px);

    border-color:
      color-mix(
        in srgb,
        var(--accent) 25%,
        var(--border-color)
      );

    box-shadow:
      0 16px 34px
      var(--shadow-color);
  }

  .skill-card-featured {
    background:
      linear-gradient(
        145deg,
        color-mix(
          in srgb,
          var(--accent) 5%,
          var(--background-secondary)
        ),
        var(--background-secondary)
      );
  }

  .skill-card-header {
    display:
      grid;

    grid-template-columns:
      auto
      minmax(0, 1fr);

    gap:
      1rem;

    align-items:
      flex-start;
  }

  .category-number {
    display:
      inline-flex;

    width:
      2.6rem;

    height:
      2.6rem;

    align-items:
      center;

    justify-content:
      center;

    flex-shrink:
      0;

    border:
      1px solid
      color-mix(
        in srgb,
        var(--accent) 22%,
        var(--border-color)
      );

    border-radius:
      0.85rem;

    background:
      color-mix(
        in srgb,
        var(--accent) 9%,
        transparent
      );

    color:
      var(--accent);

    font-size:
      0.75rem;

    font-weight:
      750;
  }

  .category-title {
    margin:
      0;

    color:
      var(--text-primary);

    font-size:
      1.1rem;

    font-weight:
      680;

    line-height:
      1.4rem;
  }

  .category-description {
    margin:
      0.4rem 0 0;

    color:
      var(--text-muted);

    font-size:
      0.8rem;

    line-height:
      1.25rem;
  }

  .skill-groups {
    display:
      flex;

    flex-direction:
      column;

    gap:
      1rem;

    margin-top:
      1.25rem;
  }

  .skill-group {
    min-width:
      0;
  }

  .group-title {
    margin:
      0 0 0.5rem;

    color:
      var(--text-secondary);

    font-size:
      0.72rem;

    font-weight:
      650;

    letter-spacing:
      0.08em;

    text-transform:
      uppercase;
  }

  .skill-tags {
    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      0.45rem;
  }

  .skill-tag {
    display:
      inline-flex;

    align-items:
      center;

    min-height:
      1.8rem;

    padding:
      0.3rem
      0.65rem;

    border:
      1px solid
      var(--border-color);

    border-radius:
      9999px;

    background:
      var(--background-primary);

    color:
      var(--text-secondary);

    font-size:
      0.73rem;

    font-weight:
      520;

    line-height:
      1rem;

    transition:
      color 150ms ease,
      background-color 150ms ease,
      border-color 150ms ease;
  }

  .skill-tag:hover {
    border-color:
      color-mix(
        in srgb,
        var(--accent) 30%,
        var(--border-color)
      );

    background:
      color-mix(
        in srgb,
        var(--accent) 7%,
        var(--background-primary)
      );

    color:
      var(--accent);
  }

  @media (max-width: 900px) {

    .skills-header {
      flex-direction:
        column;

      align-items:
        flex-start;

      gap:
        0.75rem;
    }

    .skills-grid {
      grid-template-columns:
        1fr;
    }

    .section-description {
      max-width:
        100%;
    }
  }

  @media (max-width: 640px) {

    .skills-section {
      padding:
        1.25rem;

      border-radius:
        1.5rem;
    }

    .skill-card {
      padding:
        1.15rem;
    }

    .skill-card-header {
      gap:
        0.8rem;
    }

    .category-number {
      width:
        2.35rem;

      height:
        2.35rem;
    }

    .category-title {
      font-size:
        1rem;
    }

    .category-description {
      font-size:
        0.76rem;
    }

    .skill-tag {
      font-size:
        0.7rem;
    }
  }
</style>