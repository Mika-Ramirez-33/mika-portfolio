---
import {
  useTranslations,
} from '../i18n/utils';

const t = useTranslations(
  Astro.currentLocale
);

interface FutureStudy {
  title: string;

  subtitleKey:
    | 'futureStudies.prince2.subtitle'
    | 'futureStudies.etom.subtitle';

  descriptionKey:
    | 'futureStudies.prince2.description'
    | 'futureStudies.etom.description';

  relevanceKeys: (
    | 'futureStudies.relevance.banking'
    | 'futureStudies.relevance.enterprise'
    | 'futureStudies.relevance.governance'
    | 'futureStudies.relevance.regulated'
    | 'futureStudies.relevance.telecom'
    | 'futureStudies.relevance.operations'
    | 'futureStudies.relevance.transformation'
    | 'futureStudies.relevance.serviceManagement'
  )[];

  topics: string[];

  statusKey:
    'futureStudies.status.upcoming';

  repositoryUrl: string;

  accent:
    | 'blue'
    | 'purple';
}

const futureStudies: FutureStudy[] = [
  {
    title: 'PRINCE2',

    subtitleKey:
      'futureStudies.prince2.subtitle',

    descriptionKey:
      'futureStudies.prince2.description',

    relevanceKeys: [
      'futureStudies.relevance.banking',
      'futureStudies.relevance.enterprise',
      'futureStudies.relevance.governance',
      'futureStudies.relevance.regulated',
    ],

    topics: [
      'Project Governance',
      'Business Case',
      'Roles & Responsibilities',
      'Stage Control',
      'Risk Management',
    ],

    statusKey:
      'futureStudies.status.upcoming',

    repositoryUrl:
      'TUENLACE*',

    accent:
      'blue',
  },

  {
    title:
      'eTOM',

    subtitleKey:
      'futureStudies.etom.subtitle',

    descriptionKey:
      'futureStudies.etom.description',

    relevanceKeys: [
      'futureStudies.relevance.telecom',
      'futureStudies.relevance.operations',
      'futureStudies.relevance.transformation',
      'futureStudies.relevance.serviceManagement',
    ],

    topics: [
      'Business Processes',
      'Operations',
      'Service Management',
      'Customer Management',
      'Process Architecture',
    ],

    statusKey:
      'futureStudies.status.upcoming',

    repositoryUrl:
      'TUENLACE*',

    accent:
      'purple',
  },
];
---

<section
  id="future-studies"
  class="future-studies-section"
>
  <div class="future-studies-header">

    <div>
      <p class="future-studies-eyebrow">
        {t('futureStudies.eyebrow')}
      </p>

      <h2 class="future-studies-title">
        {t('futureStudies.title')}
      </h2>
    </div>

    <p class="future-studies-description">
      {t('futureStudies.description')}
    </p>

  </div>

  <div class="future-studies-grid">
    {
      futureStudies.map((study, index) => {
        const hasRepository =
          study.repositoryUrl.startsWith('http://') ||
          study.repositoryUrl.startsWith('https://');

        return (
          <article
            class:list={[
              'future-study-card',
              `future-study-${study.accent}`,
            ]}
          >

            <div class="future-study-top">

              <span class="future-study-number">
                {String(index + 1).padStart(2, '0')}
              </span>

              <span class="future-study-status">
                <span
                  class="status-dot"
                  aria-hidden="true"
                ></span>

                {t(study.statusKey)}
              </span>

            </div>

            <div class="future-study-heading">

              <div class="future-study-icon">

                {study.title === 'PRINCE2' && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M9 6.75V5.25A2.25 2.25 0 0111.25 3h1.5A2.25 2.25 0 0115 5.25v1.5"
                    />

                    <rect
                      x="4"
                      y="7"
                      width="16"
                      height="13"
                      rx="2"
                    />

                    <path
                      stroke-linecap="round"
                      d="M8 11h8M8 15h5"
                    />
                  </svg>
                )}

                {study.title === 'eTOM' && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    aria-hidden="true"
                  >
                    <circle
                      cx="12"
                      cy="12"
                      r="3"
                    />

                    <circle
                      cx="5"
                      cy="6"
                      r="2"
                    />

                    <circle
                      cx="19"
                      cy="6"
                      r="2"
                    />

                    <circle
                      cx="5"
                      cy="18"
                      r="2"
                    />

                    <circle
                      cx="19"
                      cy="18"
                      r="2"
                    />

                    <path
                      stroke-linecap="round"
                      d="M7 7.5l3 2.5M17 7.5l-3 2.5M7 16.5l3-2.5M17 16.5l-3-2.5"
                    />
                  </svg>
                )}

              </div>

              <div>

                <h3>
                  {study.title}
                </h3>

                <p class="future-study-subtitle">
                  {t(study.subtitleKey)}
                </p>

              </div>

            </div>

            <p class="future-study-description">
              {t(study.descriptionKey)}
            </p>

            <div class="future-study-block">

              <p class="future-study-label">
                {t('futureStudies.relevanceLabel')}
              </p>

              <div class="future-study-tags">
                {
                  study.relevanceKeys.map((key) => (
                    <span class="relevance-tag">
                      {t(key)}
                    </span>
                  ))
                }
              </div>

            </div>

            <div class="future-study-block">

              <p class="future-study-label">
                {t('futureStudies.topicsLabel')}
              </p>

              <div class="future-study-tags">
                {
                  study.topics.map((topic) => (
                    <span class="topic-tag">
                      {topic}
                    </span>
                  ))
                }
              </div>

            </div>

            <div class="future-study-footer">

              <div>

                <span class="future-study-footer-label">
                  {t('futureStudies.documentation')}
                </span>

                <p>
                  {t('futureStudies.githubUpcoming')}
                </p>

              </div>

              {
                hasRepository ? (
                  <a
                    href={study.repositoryUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="future-study-action"
                  >
                    {t('futureStudies.viewStudy')}

                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M14 5h5v5M10 14L19 5M19 13v6H5V5h6"
                      />
                    </svg>
                  </a>
                ) : (
                  <span class="future-study-pending">
                    {t('futureStudies.pendingLink')}
                  </span>
                )
              }

            </div>

          </article>
        );
      })
    }
  </div>

  <div class="future-studies-note">

    <div class="future-studies-note-icon">

      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9 18h6M10 22h4M8.5 14.5A7 7 0 1115.5 14.5C14.4 15.3 14 16 14 17h-4c0-1-.4-1.7-1.5-2.5z"
        />
      </svg>

    </div>

    <div>

      <strong>
        {t('futureStudies.note.title')}
      </strong>

      <p>
        {t('futureStudies.note.description')}
      </p>

    </div>

  </div>

</section>

<style>
  .future-studies-section {
    padding: 2rem;

    border:
      1px solid
      var(--border-color);

    border-radius:
      2rem;

    background:
      var(--background-elevated);

    box-shadow:
      0 20px 50px
      var(--shadow-color);

    backdrop-filter:
      blur(18px);

    -webkit-backdrop-filter:
      blur(18px);
  }

  .future-studies-header {
    display:
      flex;

    align-items:
      flex-end;

    justify-content:
      space-between;

    gap:
      2rem;

    margin-bottom:
      1.75rem;
  }

  .future-studies-eyebrow {
    margin:
      0;

    color:
      var(--accent);

    font-size:
      0.75rem;

    font-weight:
      700;

    letter-spacing:
      0.18em;

    text-transform:
      uppercase;
  }

  .future-studies-title {
    margin:
      0.4rem 0 0;

    color:
      var(--text-primary);

    font-size:
      clamp(
        1.8rem,
        3vw,
        2.4rem
      );

    font-weight:
      720;

    letter-spacing:
      -0.035em;
  }

  .future-studies-description {
    max-width:
      39rem;

    margin:
      0;

    color:
      var(--text-secondary);

    font-size:
      0.9rem;

    line-height:
      1.5rem;
  }

  .future-studies-grid {
    display:
      grid;

    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );

    gap:
      1rem;
  }

  .future-study-card {
    --study-accent:
      var(--accent);

    position:
      relative;

    display:
      flex;

    flex-direction:
      column;

    min-width:
      0;

    padding:
      1.4rem;

    border:
      1px solid
      var(--border-color);

    border-radius:
      1.4rem;

    background:
      linear-gradient(
        145deg,
        color-mix(
          in srgb,
          var(--study-accent) 5%,
          var(--background-secondary)
        ),
        var(--background-secondary)
      );

    overflow:
      hidden;

    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .future-study-blue {
    --study-accent:
      var(--accent);
  }

  .future-study-purple {
    --study-accent:
      rgb(168, 85, 247);
  }

  .future-study-card:hover {
    transform:
      translateY(-3px);

    border-color:
      color-mix(
        in srgb,
        var(--study-accent) 30%,
        var(--border-color)
      );

    box-shadow:
      0 16px 36px
      var(--shadow-color);
  }

  .future-study-top {
    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    gap:
      1rem;
  }

  .future-study-number {
    color:
      var(--study-accent);

    font-size:
      0.68rem;

    font-weight:
      750;

    letter-spacing:
      0.08em;
  }

  .future-study-status {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.4rem;

    padding:
      0.3rem 0.6rem;

    border:
      1px solid
      color-mix(
        in srgb,
        var(--study-accent) 25%,
        var(--border-color)
      );

    border-radius:
      9999px;

    background:
      color-mix(
        in srgb,
        var(--study-accent) 8%,
        var(--background-primary)
      );

    color:
      var(--study-accent);

    font-size:
      0.63rem;

    font-weight:
      650;
  }

  .status-dot {
    width:
      0.4rem;

    height:
      0.4rem;

    border-radius:
      9999px;

    background:
      var(--study-accent);
  }

  .future-study-heading {
    display:
      flex;

    align-items:
      center;

    gap:
      0.9rem;

    margin-top:
      1rem;
  }

  .future-study-icon {
    display:
      flex;

    width:
      3.2rem;

    height:
      3.2rem;

    flex-shrink:
      0;

    align-items:
      center;

    justify-content:
      center;

    border:
      1px solid
      color-mix(
        in srgb,
        var(--study-accent) 18%,
        var(--border-color)
      );

    border-radius:
      1rem;

    background:
      color-mix(
        in srgb,
        var(--study-accent) 10%,
        transparent
      );

    color:
      var(--study-accent);
  }

  .future-study-icon svg {
    width:
      1.55rem;

    height:
      1.55rem;
  }

  .future-study-heading h3 {
    margin:
      0;

    color:
      var(--text-primary);

    font-size:
      1.25rem;

    font-weight:
      720;
  }

  .future-study-subtitle {
    margin:
      0.2rem 0 0;

    color:
      var(--text-muted);

    font-size:
      0.75rem;

    line-height:
      1.1rem;
  }

  .future-study-description {
    margin:
      1rem 0 0;

    color:
      var(--text-secondary);

    font-size:
      0.8rem;

    line-height:
      1.35rem;
  }

  .future-study-block {
    margin-top:
      1rem;

    padding-top:
      0.9rem;

    border-top:
      1px solid
      var(--border-color);
  }

  .future-study-label {
    margin:
      0 0 0.55rem;

    color:
      var(--text-muted);

    font-size:
      0.66rem;

    font-weight:
      700;

    letter-spacing:
      0.08em;

    text-transform:
      uppercase;
  }

  .future-study-tags {
    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      0.4rem;
  }

  .relevance-tag,
  .topic-tag {
    display:
      inline-flex;

    align-items:
      center;

    min-height:
      1.8rem;

    padding:
      0.28rem 0.6rem;

    border-radius:
      9999px;

    font-size:
      0.64rem;

    font-weight:
      550;
  }

  .relevance-tag {
    border:
      1px solid
      color-mix(
        in srgb,
        var(--study-accent) 22%,
        var(--border-color)
      );

    background:
      color-mix(
        in srgb,
        var(--study-accent) 7%,
        var(--background-primary)
      );

    color:
      var(--study-accent);
  }

  .topic-tag {
    border:
      1px solid
      var(--border-color);

    background:
      var(--background-primary);

    color:
      var(--text-muted);
  }

  .future-study-footer {
    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    gap:
      1rem;

    margin-top:
      auto;

    padding-top:
      1.1rem;
  }

  .future-study-footer-label {
    color:
      var(--text-muted);

    font-size:
      0.6rem;

    font-weight:
      700;

    letter-spacing:
      0.1em;
  }

  .future-study-footer p {
    margin:
      0.18rem 0 0;

    color:
      var(--text-secondary);

    font-size:
      0.67rem;
  }

  .future-study-action {
    display:
      inline-flex;

    min-height:
      2.4rem;

    align-items:
      center;

    justify-content:
      center;

    gap:
      0.4rem;

    padding:
      0.55rem 0.8rem;

    border-radius:
      0.7rem;

    background:
      var(--study-accent);

    color:
      white;

    font-size:
      0.7rem;

    font-weight:
      650;

    text-decoration:
      none;
  }

  .future-study-action svg {
    width:
      0.9rem;

    height:
      0.9rem;
  }

  .future-study-pending {
    display:
      inline-flex;

    min-height:
      2.4rem;

    align-items:
      center;

    justify-content:
      center;

    padding:
      0.55rem 0.8rem;

    border:
      1px solid
      var(--border-color);

    border-radius:
      0.7rem;

    background:
      var(--background-primary);

    color:
      var(--text-muted);

    font-size:
      0.68rem;
  }

  .future-studies-note {
    display:
      flex;

    align-items:
      center;

    gap:
      0.85rem;

    margin-top:
      1rem;

    padding:
      0.9rem 1rem;

    border:
      1px solid
      var(--border-color);

    border-radius:
      1rem;

    background:
      color-mix(
        in srgb,
        var(--accent) 4%,
        var(--background-secondary)
      );
  }

  .future-studies-note-icon {
    display:
      flex;

    width:
      2.6rem;

    height:
      2.6rem;

    flex-shrink:
      0;

    align-items:
      center;

    justify-content:
      center;

    border-radius:
      0.85rem;

    background:
      color-mix(
        in srgb,
        var(--accent) 10%,
        transparent
      );

    color:
      var(--accent);
  }

  .future-studies-note-icon svg {
    width:
      1.3rem;

    height:
      1.3rem;
  }

  .future-studies-note strong {
    display:
      block;

    color:
      var(--text-primary);

    font-size:
      0.78rem;
  }

  .future-studies-note p {
    margin:
      0.2rem 0 0;

    color:
      var(--text-muted);

    font-size:
      0.68rem;

    line-height:
      1rem;
  }

  @media (max-width: 900px) {

    .future-studies-header {
      flex-direction:
        column;

      align-items:
        flex-start;

      gap:
        0.75rem;
    }

    .future-studies-grid {
      grid-template-columns:
        1fr;
    }
  }

  @media (max-width: 640px) {

    .future-studies-section {
      padding:
        1.25rem;

      border-radius:
        1.5rem;
    }

    .future-study-card {
      padding:
        1.15rem;
    }

    .future-study-footer {
      align-items:
        flex-start;

      flex-direction:
        column;
    }

    .future-study-action,
    .future-study-pending {
      width:
        100%;
    }

    .future-studies-note {
      align-items:
        flex-start;
    }
  }
</style>