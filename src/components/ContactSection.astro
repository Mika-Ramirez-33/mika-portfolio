---
import {
  useTranslations,
} from '../i18n/utils';

const t = useTranslations(
  Astro.currentLocale
);

const lang =
  Astro.currentLocale === 'en'
    ? 'en'
    : 'es';

const email = 'karmirlopez@gmail.com';

const contactLinks = [
  {
    id: 'email',
    label: 'Email',
    value: email,
    href: `mailto:${email}`,
    icon: 'email',
  },
  {
    id: 'linkedin',
    label: 'LinkedIn',
    value: 'linkedin.com/in/mika-lopez-a4a088229',
    href: 'https://www.linkedin.com/in/mika-lopez-a4a088229/',
    icon: 'linkedin',
  },
  {
    id: 'github',
    label: 'GitHub',
    value: 'github.com/Mika-Ramirez-33',
    href: 'https://github.com/Mika-Ramirez-33',
    icon: 'github',
  },
];

const coverLetter = {
  spanishFile:
      'https://drive.google.com/file/d/1MbXbuv1psG8p6yIZfNDy7QBO6_AXw6Kr/view',

  englishFile:
     'https://drive.google.com/file/d/1MbXbuv1psG8p6yIZfNDy7QBO6_AXw6Kr/view',

  updated:
    '2026',
};

const currentCoverLetter =
  lang === 'en'
    ? coverLetter.englishFile
    : coverLetter.spanishFile;

const secondaryCoverLetter =
  lang === 'en'
    ? coverLetter.spanishFile
    : coverLetter.englishFile;

const secondaryLanguageLabel =
  lang === 'en'
    ? 'ES'
    : 'EN';
---

<section
  id="contact"
  class="contact-section"
>
  <div class="contact-layout">

    <!-- Left Column -->
    <div class="contact-intro">

      <h2 class="contact-title">
        {t('contact.title.line1')}

        <span>
          {t('contact.title.line2')}
        </span>
      </h2>

      <p class="contact-description">
        {t('contact.description')}
      </p>

      <!-- Availability -->
      <div class="availability-banner">

        <div class="availability-status">
          <span class="status-dot"></span>

          <span class="availability-title">
            {t('contact.availability.title')}
          </span>
        </div>

        <span class="availability-message">
          {t('contact.availability.message')}
        </span>

        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="availability-icon"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"
          />
        </svg>

      </div>

      <!-- Professional Values -->
      <div class="collaboration-grid">

        <article class="collaboration-card">

          <div class="collaboration-icon icon-projects">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 6.75V5.25A2.25 2.25 0 0111.25 3h1.5A2.25 2.25 0 0115 5.25v1.5M4.5 9h15v8.25A2.25 2.25 0 0117.25 19.5H6.75A2.25 2.25 0 014.5 17.25V9z"
              />
            </svg>
          </div>

          <h3>
            {t('contact.commitment.title')}
          </h3>

          <p>
            {t('contact.commitment.description')}
          </p>

        </article>

        <article class="collaboration-card">

          <div class="collaboration-icon icon-collaboration">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM22 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"
              />
            </svg>
          </div>

          <h3>
            {t('contact.learning.title')}
          </h3>

          <p>
            {t('contact.learning.description')}
          </p>

        </article>

        <article class="collaboration-card">

          <div class="collaboration-icon icon-consulting">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 18h6M10 22h4M8.5 14.5A7 7 0 1115.5 14.5C14.4 15.3 14 16 14 17h-4c0-1-.4-1.7-1.5-2.5z"
              />
            </svg>
          </div>

          <h3>
            {t('contact.technical.title')}
          </h3>

          <p>
            {t('contact.technical.description')}
          </p>

        </article>

      </div>
    </div>

    <!-- Right Column -->
    <aside class="contact-card">

      <div class="contact-card-heading">

        <div class="contact-main-icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M22 2L11 13"
            />

            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M22 2l-7 20-4-9-9-4 20-7z"
            />
          </svg>
        </div>

        <div>
          <h3>
            {t('contact.connect')}
          </h3>
        </div>

      </div>

      <div class="contact-links">
        {
          contactLinks.map((contact) => (

            <div class="contact-link-row">

              <a
                href={contact.href}
                target={
                  contact.id === 'email'
                    ? undefined
                    : '_blank'
                }
                rel={
                  contact.id === 'email'
                    ? undefined
                    : 'noopener noreferrer'
                }
                class="contact-link-main"
              >

                <div
                  class={`contact-link-icon icon-${contact.id}`}
                >

                  {contact.icon === 'email' && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3 6.75A2.25 2.25 0 015.25 4.5h13.5A2.25 2.25 0 0121 6.75v10.5a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 17.25V6.75z"
                      />

                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3.75 6l7.064 5.138a2 2 0 002.372 0L20.25 6"
                      />
                    </svg>
                  )}

                  {contact.icon === 'linkedin' && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.047c.475-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 110-4.124 2.062 2.062 0 010 4.124zM3.56 9h3.554v11.452H3.56V9z" />
                    </svg>
                  )}

                  {contact.icon === 'github' && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  )}

                </div>

                <div class="contact-link-text">
                  <span>
                    {contact.label}
                  </span>

                  <small>
                    {contact.value}
                  </small>
                </div>

              </a>

              {
                contact.id === 'email'
                  ? (
                    <button
                      type="button"
                      class="copy-button"
                      data-copy-email={email}
                      aria-label={t('contact.copyEmail')}
                      title={t('contact.copyEmailTitle')}
                    >
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        aria-hidden="true"
                      >
                        <rect
                          x="9"
                          y="9"
                          width="11"
                          height="11"
                          rx="2"
                        />

                        <path
                          d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"
                        />
                      </svg>
                    </button>
                  )
                  : (
                    <svg
                      class="external-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M14 5h5v5M10 14L19 5M19 13v6H5V5h6"
                      />
                    </svg>
                  )
              }

            </div>

          ))
        }
      </div>

      <!-- Location -->
      <div class="contact-detail">

        <div class="contact-detail-icon location-icon">
          <svg
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 00-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 002.682 2.282 16.975 16.975 0 001.145.742zM12 13.5a3 3 0 100-6 3 3 0 000 6z"
              clip-rule="evenodd"
            />
          </svg>
        </div>

        <div>
          <span class="detail-label">
            {t('contact.location.label')}
          </span>

          <strong>
            {t('contact.location.value')}
          </strong>

          <small class="detail-success">
            {t('contact.location.availability')}
          </small>
        </div>

      </div>

      <!-- Work Modality -->
      <div class="contact-detail">

        <div class="contact-detail-icon work-icon">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <rect
              x="3"
              y="4"
              width="18"
              height="12"
              rx="2"
            />

            <path
              stroke-linecap="round"
              d="M8 20h8M12 16v4"
            />
          </svg>
        </div>

        <div>
          <span class="detail-label">
            {t('contact.modality.label')}
          </span>

          <strong>
            {t('contact.modality.value')}
          </strong>

          <small>
            {t('contact.modality.availability')}
          </small>
        </div>

      </div>

      <!-- Cover Letter -->
      <div class="cover-letter-card">

        <div class="cover-letter-header">

          <div class="cover-letter-icon">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M7 3.75h7.5L19.5 8.7v11.55A1.75 1.75 0 0117.75 22H7A1.75 1.75 0 015.25 20.25V5.5A1.75 1.75 0 017 3.75z"
              />

              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M14.5 3.75V9H19.5M8.5 13h7M8.5 16.5h7"
              />
            </svg>
          </div>

          <div>
            <span class="cover-letter-eyebrow">
              {t('contact.coverLetter.eyebrow')}
            </span>

            <h3>
              {t('contact.coverLetter.title')}
            </h3>
          </div>

        </div>

        <p class="cover-letter-description">
          {t('contact.coverLetter.description')}
        </p>

        <div class="document-preview">

          <div class="document-badge">
            PDF
          </div>

          <div class="document-info">
            <strong>
              Mika Ramirez
            </strong>

            <span>
              Technical Project Manager
            </span>
          </div>

          <div class="document-status">
            <span class="document-status-dot"></span>

            {t('contact.coverLetter.updated')}
            {' '}
            {coverLetter.updated}
          </div>

        </div>

        <p class="cover-letter-note">
          {t('contact.coverLetter.note')}
        </p>

        <div class="cover-letter-actions">

          <a
            href={currentCoverLetter}
            download
            class="cover-letter-primary"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.9"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 3v12m0 0l-4-4m4 4l4-4M5 20h14"
              />
            </svg>

            {t('contact.coverLetter.download')}
          </a>

          <a
            href={secondaryCoverLetter}
            download
            class="cover-letter-secondary"
            aria-label={`Download ${secondaryLanguageLabel} cover letter`}
          >
            {secondaryLanguageLabel}
          </a>

        </div>

      </div>

    </aside>

  </div>

  <div
    id="copy-notification"
    class="copy-notification"
    role="status"
    aria-live="polite"
  >
    {t('contact.emailCopied')}
  </div>
</section>

<script>
  const copyButton =
    document.querySelector<HTMLButtonElement>(
      '[data-copy-email]'
    );

  const notification =
    document.getElementById(
      'copy-notification'
    );

  copyButton?.addEventListener(
    'click',
    async () => {
      const email =
        copyButton.dataset.copyEmail;

      if (!email) return;

      try {
        await navigator.clipboard.writeText(
          email
        );

        notification?.classList.add(
          'show'
        );

        window.setTimeout(() => {
          notification?.classList.remove(
            'show'
          );
        }, 1800);
      } catch {
        window.location.href =
          `mailto:${email}`;
      }
    }
  );
</script>

<style>
  /* =========================================
     CONTACT SECTION
     ========================================= */

  .contact-section {
    position: relative;
    padding: clamp(1.4rem, 4vw, 2.6rem);

    border: 1px solid var(--border-color);
    border-radius: 2rem;

    background:
      linear-gradient(
        145deg,
        color-mix(
          in srgb,
          var(--background-elevated) 96%,
          var(--accent) 4%
        ),
        var(--background-elevated)
      );

    box-shadow:
      0 24px 60px
      var(--shadow-color);

    overflow: hidden;
  }

  /* =========================================
     MAIN LAYOUT
     ========================================= */

  .contact-layout {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(22rem, 0.82fr);

    align-items: stretch;

    gap:
      clamp(2rem, 4vw, 3.5rem);
  }

  /*
    IMPORTANTE:
    La columna izquierda ahora ocupa toda la
    altura disponible de la fila.
  */
  .contact-intro {
    display: flex;
    flex-direction: column;

    min-width: 0;
    height: 100%;
  }

  /* =========================================
     TITLE
     ========================================= */

  .contact-eyebrow {
    margin: 0 0 1rem;

    color: var(--accent);

    font-size: 0.75rem;
    font-weight: 700;

    letter-spacing: 0.2em;
  }

  .contact-title {
    max-width: 44rem;

    margin: 0;

    color: var(--text-primary);

    font-size:
      clamp(2.3rem, 5.5vw, 4.4rem);

    font-weight: 780;

    line-height: 1.02;

    letter-spacing: -0.055em;
  }

  .contact-title span {
    display: block;

    margin-top: 0.25rem;

    color: var(--accent);
  }

  .contact-description {
    max-width: 44rem;

    margin: 1.5rem 0 0;

    color: var(--text-secondary);

    font-size:
      clamp(0.95rem, 1.7vw, 1.08rem);

    line-height: 1.7;
  }

  /* =========================================
     AVAILABILITY
     ========================================= */

  .availability-banner {
    display: flex;

    max-width: 36rem;

    align-items: center;

    gap: 0.75rem;

    margin-top: 1.5rem;

    padding:
      0.7rem
      1rem;

    border:
      1px solid
      color-mix(
        in srgb,
        rgb(34, 197, 94) 25%,
        var(--border-color)
      );

    border-radius: 0.8rem;

    background:
      color-mix(
        in srgb,
        rgb(34, 197, 94) 7%,
        var(--background-secondary)
      );
  }

  .availability-status {
    display: flex;

    align-items: center;

    gap: 0.55rem;
  }

  .status-dot {
    width: 0.5rem;
    height: 0.5rem;

    flex-shrink: 0;

    border-radius: 9999px;

    background:
      rgb(34, 197, 94);

    box-shadow:
      0 0 0 4px
      color-mix(
        in srgb,
        rgb(34, 197, 94) 12%,
        transparent
      );
  }

  .availability-title {
    color:
      rgb(34, 197, 94);

    font-size: 0.72rem;
    font-weight: 750;

    letter-spacing: 0.1em;
  }

  .availability-message {
    margin-left: auto;

    color: var(--text-muted);

    font-size: 0.75rem;
  }

  .availability-icon {
    width: 1rem;
    height: 1rem;

    flex-shrink: 0;

    color:
      rgb(34, 197, 94);
  }

  /* =========================================
     PROFESSIONAL VALUES
     ========================================= */

  /*
    Esta es la corrección principal.

    flex: 1 hace que las tarjetas ocupen
    el espacio que queda debajo del banner.
  */
  .collaboration-grid {
    display: grid;

    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );

    grid-template-rows: 1fr;

    flex: 1;

    align-items: stretch;

    gap: 0.9rem;

    margin-top: 1.4rem;
  }

  .collaboration-card {
    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: flex-start;

    width: 100%;
    height: 100%;

    min-width: 0;

    padding:
      1.2rem
      1rem;

    border:
      1px solid
      var(--border-color);

    border-radius:
      1.2rem;

    background:
      var(--background-secondary);

    text-align: center;

    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .collaboration-card:hover {
    transform:
      translateY(-3px);

    border-color:
      color-mix(
        in srgb,
        var(--accent) 28%,
        var(--border-color)
      );

    box-shadow:
      0 14px 30px
      var(--shadow-color);
  }

  .collaboration-icon {
    display: flex;

    width: 3rem;
    height: 3rem;

    flex-shrink: 0;

    align-items: center;
    justify-content: center;

    margin:
      0 auto
      0.8rem;

    border-radius:
      1rem;
  }

  .collaboration-icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .icon-projects {
    background:
      color-mix(
        in srgb,
        var(--accent) 13%,
        transparent
      );

    color:
      var(--accent);
  }

  .icon-collaboration {
    background:
      color-mix(
        in srgb,
        rgb(168, 85, 247) 13%,
        transparent
      );

    color:
      rgb(168, 85, 247);
  }

  .icon-consulting {
    background:
      color-mix(
        in srgb,
        rgb(6, 182, 212) 13%,
        transparent
      );

    color:
      rgb(6, 182, 212);
  }

  .collaboration-card h3 {
    margin: 0;

    color:
      var(--text-primary);

    font-size:
      0.92rem;

    font-weight:
      680;

    line-height:
      1.3rem;
  }

  .collaboration-card p {
    margin:
      0.3rem 0 0;

    color:
      var(--text-muted);

    font-size:
      0.73rem;

    line-height:
      1.1rem;
  }

  /* =========================================
     RIGHT CONTACT CARD
     ========================================= */

  .contact-card {
    display: flex;

    flex-direction: column;

    align-self: stretch;

    width: 100%;
    height: 100%;

    min-width: 0;

    padding:
      1.35rem;

    border:
      1px solid
      color-mix(
        in srgb,
        var(--accent) 35%,
        var(--border-color)
      );

    border-radius:
      1.4rem;

    background:
      color-mix(
        in srgb,
        var(--background-secondary) 94%,
        var(--accent) 6%
      );

    box-shadow:
      0 18px 45px
      var(--shadow-color);
  }

  .contact-card-heading {
    display: flex;

    align-items: center;

    gap: 0.9rem;

    margin-bottom:
      1.1rem;
  }

  .contact-main-icon {
    display: flex;

    width: 3rem;
    height: 3rem;

    flex-shrink: 0;

    align-items: center;
    justify-content: center;

    border-radius:
      9999px;

    background:
      var(--accent);

    color:
      white;

