---
import {
  useTranslations,
} from '../i18n/utils';

const t = useTranslations(
  Astro.currentLocale
);

const socialLinks = [
  {
    name: 'GitHub',
    url: 'https://github.com/Mika-Ramirez-33',
    icon: 'github',
  },
  {
    name: 'LinkedIn',
    url: 'https://www.linkedin.com/in/mika-lopez-a4a088229/',
    icon: 'linkedin',
  },
] as const;

const projectManagementStart =
  new Date('2022-04-01');

const projectManagementEnd =
  new Date('2026-08-31');

const totalMonths =
  (
    projectManagementEnd.getFullYear() -
    projectManagementStart.getFullYear()
  ) * 12 +
  (
    projectManagementEnd.getMonth() -
    projectManagementStart.getMonth()
  );

const experienceYears =
  Math.floor(totalMonths / 12);

const experienceMonths =
  totalMonths % 12;

const yearLabel =
  experienceYears === 1
    ? t('info.experience.year')
    : t('info.experience.years');

const monthLabel =
  experienceMonths === 1
    ? t('info.experience.month')
    : t('info.experience.months');

const experienceLabel =
  experienceMonths > 0
    ? `${experienceYears} ${yearLabel} ${experienceMonths} ${monthLabel}`
    : `${experienceYears} ${yearLabel}`;
---

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">

  <!-- Location -->
  <article class="info-card">

    <div class="info-card-content">

      <div class="icon-circle icon-location">

        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="info-icon"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 00-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 002.682 2.282 16.975 16.975 0 001.145.742zM12 13.5a3 3 0 100-6 3 3 0 000 6z"
            clip-rule="evenodd"
          />
        </svg>

      </div>

      <div class="info-text">

        <p class="info-label">
          {t('info.location.label')}
        </p>

        <p class="info-value">
          {t('info.location.value')}
        </p>

      </div>

    </div>

  </article>


  <!-- Project Management Experience -->
  <article class="info-card">

    <div class="info-card-content">

      <div class="icon-circle icon-experience">

        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="info-icon"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M7.5 5.25A2.25 2.25 0 019.75 3h4.5a2.25 2.25 0 012.25 2.25V6h2.25A2.25 2.25 0 0121 8.25v8.5A2.25 2.25 0 0118.75 19H5.25A2.25 2.25 0 013 16.75v-8.5A2.25 2.25 0 015.25 6H7.5v-.75zm2.25 0V6h4.5v-.75a.75.75 0 00-.75-.75h-3a.75.75 0 00-.75.75z"
            clip-rule="evenodd"
          />
        </svg>

      </div>

      <div class="info-text">

        <p class="info-label">
          {t('info.experience.label')}
        </p>

        <p class="experience-value">
          {experienceLabel}
        </p>

      </div>

    </div>

  </article>


  <!-- Work Modality -->
  <article class="info-card">

    <div class="info-card-content">

      <div class="icon-circle icon-modality">

        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="info-icon"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M4.5 5.25A2.25 2.25 0 016.75 3h10.5a2.25 2.25 0 012.25 2.25v8.5A2.25 2.25 0 0117.25 16H13.5v1.5h3a.75.75 0 010 1.5h-9a.75.75 0 010-1.5h3V16H6.75a2.25 2.25 0 01-2.25-2.25v-8.5z"
            clip-rule="evenodd"
          />
        </svg>

      </div>

      <div class="info-text">

        <p class="info-label">
          {t('info.modality.label')}
        </p>

        <p class="info-value modality-value">
          {t('info.modality.value')}
        </p>

        <div class="availability-row">

          <span
            class="availability-dot"
            aria-hidden="true"
          ></span>

          <span>
            {t('info.modality.availability')}
          </span>

        </div>

      </div>

    </div>

  </article>


  <!-- Social Profiles -->
  <article class="info-card">

    <div class="info-card-content">

      <div class="icon-circle icon-social">

        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="info-icon"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M8.25 6.75a3.75 3.75 0 117.5 0 3.75 3.75 0 01-7.5 0zM15.75 9.75a3 3 0 116 0 3 3 0 01-6 0zM2.25 9.75a3 3 0 116 0 3 3 0 01-6 0zM6.31 15.117A6.745 6.745 0 0112 12a6.745 6.745 0 016.709 7.498.75.75 0 01-.372.568A12.696 12.696 0 0112 21.75c-2.305 0-4.47-.612-6.337-1.684a.75.75 0 01-.372-.568 6.745 6.745 0 011.019-4.381z"
            clip-rule="evenodd"
          />
        </svg>

      </div>

      <div class="info-text">

        <p class="info-label">
          {t('info.social.label')}
        </p>

        <div class="social-links">

          {
            socialLinks.map((link) => (

              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="social-button"
                aria-label={`${t('info.social.open')} ${link.name}`}
                title={link.name}
              >

                {link.icon === 'github' && (

                  <svg
                    class="social-icon"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                      clip-rule="evenodd"
                    />
                  </svg>

                )}

                {link.icon === 'linkedin' && (

                  <svg
                    class="social-icon"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M19 0H5C2.239 0 0 2.239 0 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5V5c0-2.761-2.238-5-5-5zM8 19H5V8h3v11zM6.5 6.732c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zM20 19h-3v-5.604c0-3.368-4-3.113-4 0V19h-3V8h3v1.765c1.396-2.586 7-2.777 7 2.476V19z"
                      clip-rule="evenodd"
                    />
                  </svg>

                )}

              </a>

            ))
          }

        </div>

      </div>

    </div>

  </article>

</div>

<style>
  .info-card {
    min-height: 9.5rem;
    padding: 1.35rem;
    border: 1px solid var(--border-color);
    border-radius: 1.25rem;
    background: var(--background-elevated);
    color: var(--text-primary);
    box-shadow: 0 12px 30px var(--shadow-color);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition:
      transform 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .info-card:hover {
    transform: translateY(-3px);
    background: var(--background-secondary);
    box-shadow: 0 18px 40px var(--shadow-color);
  }

  .info-card-content {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    height: 100%;
  }

  .info-text {
    min-width: 0;
    flex: 1;
  }

  .info-label {
    margin: 0 0 0.2rem;
    color: var(--text-muted);
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.25rem;
  }

  .info-value {
    margin: 0;
    color: var(--text-primary);
    font-size: 1.1rem;
    font-weight: 650;
    line-height: 1.45rem;
  }

  .experience-value {
    margin: 0.15rem 0 0;
    color: var(--text-primary);
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    font-weight: 750;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .info-note {
    margin: 0.35rem 0 0;
    color: var(--text-muted);
    font-size: 0.76rem;
    line-height: 1.1rem;
  }

  .modality-value {
    max-width: 15rem;
  }

  .availability-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.55rem;
    color: var(--text-muted);
    font-size: 0.74rem;
    line-height: 1rem;
  }

  .availability-dot {
    width: 0.42rem;
    height: 0.42rem;
    flex-shrink: 0;
    border-radius: 9999px;
    background: rgb(34, 197, 94);
    box-shadow:
      0 0 0 4px
      color-mix(
        in srgb,
        rgb(34, 197, 94) 12%,
        transparent
      );
  }

  .icon-circle {
    display: flex;
    width: 2.85rem;
    height: 2.85rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-color);
    border-radius: 9999px;
    transition:
      transform 180ms ease,
      background-color 180ms ease,
      color 180ms ease;
  }

  .info-card:hover .icon-circle {
    transform: scale(1.04);
  }

  .info-icon {
    width: 1.35rem;
    height: 1.35rem;
  }

  .icon-location {
    background:
      color-mix(
        in srgb,
        rgb(239, 68, 68) 14%,
        transparent
      );
    color: rgb(239, 68, 68);
  }

  .icon-experience {
    background:
      color-mix(
        in srgb,
        rgb(168, 85, 247) 14%,
        transparent
      );
    color: rgb(168, 85, 247);
  }

  .icon-modality {
    background:
      color-mix(
        in srgb,
        rgb(34, 197, 94) 14%,
        transparent
      );
    color: rgb(34, 197, 94);
  }

  .icon-social {
    background:
      color-mix(
        in srgb,
        var(--accent) 14%,
        transparent
      );
    color: var(--accent);
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.45rem;
  }

  .social-button {
    display: inline-flex;
    width: 2.6rem;
    height: 2.6rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    background: var(--background-primary);
    color: var(--text-secondary);
    transition:
      transform 150ms ease,
      color 150ms ease,
      border-color 150ms ease,
      background-color 150ms ease;
  }

  .social-button:hover {
    transform: translateY(-2px);
    color: var(--accent);
    border-color:
      color-mix(
        in srgb,
        var(--accent) 35%,
        var(--border-color)
      );
    background:
      color-mix(
        in srgb,
        var(--accent) 8%,
        var(--background-primary)
      );
  }

  .social-icon {
    width: 1.35rem;
    height: 1.35rem;
  }

  @media (max-width: 640px) {

    .info-card {
      min-height: auto;
      padding: 1.15rem;
    }

    .icon-circle {
      width: 2.65rem;
      height: 2.65rem;
    }

    .info-value {
      font-size: 1rem;
    }

    .experience-value {
      font-size: 1.45rem;
    }

  }
</style>