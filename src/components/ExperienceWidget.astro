---
import {
  useTranslations,
} from '../i18n/utils';

const t = useTranslations(
  Astro.currentLocale
);

type TranslationKey =
  Parameters<typeof t>[0];

interface Experience {
  roleKey: TranslationKey;
  company: string;
  client?: string;
  locationKey: TranslationKey;
  periodKey: TranslationKey;
  descriptionKeys: TranslationKey[];
  tags: string[];
}

const experiences: Experience[] = [
  {
    roleKey:
      'experience.t3.role',

    company:
      'T3s Tecnologías México',

    client:
      'Gentera · Compartamos Banco',

    locationKey:
      'experience.t3.location',

    periodKey:
      'experience.t3.period',

    descriptionKeys: [
      'experience.t3.description1',
      'experience.t3.description2',
      'experience.t3.description3',
      'experience.t3.description4',
      'experience.t3.description5',
    ],

    tags: [
      'Cybersecurity',
      'Project Management',
      'Audit Remediation',
      'Executive Reporting',
      'Documentation',
      'CSIRT',
      'Data Protection',
      'PoC',
    ],
  },

  {
    roleKey:
      'experience.qualtop.role',

    company:
      'Qualtop',

    client:
      'Gentera · Compartamos Banco',

    locationKey:
      'experience.qualtop.location',

    periodKey:
      'experience.qualtop.period',

    descriptionKeys: [
      'experience.qualtop.description1',
      'experience.qualtop.description2',
      'experience.qualtop.description3',
      'experience.qualtop.description4',
    ],

    tags: [
      'Project Management',
      'Scrum',
      'BAU',
      'PCI DSS',
      'ISO 27001',
      'SPEI',
      'KPIs & KRIs',
      'Cross-functional Teams',
    ],
  },

  {
    roleKey:
      'experience.merr.role',

    company:
      'MERR Informática',

    locationKey:
      'experience.merr.location',

    periodKey:
      'experience.merr.period',

    descriptionKeys: [
      'experience.merr.description1',
      'experience.merr.description2',
      'experience.merr.description3',
      'experience.merr.description4',
    ],

    tags: [
      'Project Management',
      'Angular',
      'Node.js',
      'MySQL',
      'REST API',
      'UI/UX',
      'QA',
      'AVEVA PI System',
    ],
  },

  {
    roleKey:
      'experience.tesePm.role',

    company:
      'TESE',

    locationKey:
      'experience.tesePm.location',

    periodKey:
      'experience.tesePm.period',

    descriptionKeys: [
      'experience.tesePm.description1',
      'experience.tesePm.description2',
      'experience.tesePm.description3',
      'experience.tesePm.description4',
    ],

    tags: [
      'Scrum',
      'Kanban',
      'Waterfall',
      'Requirements',
      'Product Ownership',
      'Jira',
      'Confluence',
      'Multi-project Management',
    ],
  },

  {
    roleKey:
      'experience.teseEducation.role',

    company:
      'TESE · Educación a Distancia',

    locationKey:
      'experience.teseEducation.location',

    periodKey:
      'experience.teseEducation.period',

    descriptionKeys: [
      'experience.teseEducation.description1',
      'experience.teseEducation.description2',
    ],

    tags: [
      'Moodle',
      'SCORM',
      'Instructional Design',
      'Automation',
      'Documentation',
      'Digital Enablement',
    ],
  },
];
---

<section
  id="experience"
  class="experience-section"
>
  <header class="experience-header">

    <p class="experience-eyebrow">
      {t('experience.eyebrow')}
    </p>

    <h2 class="experience-title">
      {t('experience.title')}
    </h2>

    <p class="experience-introduction">
      {t('experience.description')}
    </p>

  </header>

  <div class="experience-list">
    {
      experiences.map((experience) => (

        <article class="experience-item">

          <span
            class="experience-dot"
            aria-hidden="true"
          ></span>

          <div class="experience-top">

            <div class="experience-heading">

              <h3 class="experience-role">
                {t(experience.roleKey)}
              </h3>

              <p class="experience-company">
                {experience.company}
              </p>

              {
                experience.client && (
                  <p class="experience-client">
                    {experience.client}
                  </p>
                )
              }

              <p class="experience-location">
                {t(experience.locationKey)}
              </p>

            </div>

            <span class="experience-period">
              {t(experience.periodKey)}
            </span>

          </div>

          <ul class="experience-description">
            {
              experience.descriptionKeys.map(
                (descriptionKey) => (

                  <li class="experience-description-item">

                    <span
                      class="experience-bullet"
                      aria-hidden="true"
                    ></span>

                    <span>
                      {t(descriptionKey)}
                    </span>

                  </li>

                )
              )
            }
          </ul>

          <div class="experience-tags">
            {
              experience.tags.map((tag) => (

                <span class="experience-tag">
                  {tag}
                </span>

              ))
            }
          </div>

        </article>

      ))
    }
  </div>
</section>

<style>
  .experience-section {
    padding: 2rem;

    border:
      1px solid
      var(--border-color);

    border-radius:
      2rem;

    background:
      var(--background-elevated);

    box-shadow:
      0 20px 50px
      var(--shadow-color);

    backdrop-filter:
      blur(18px);

    -webkit-backdrop-filter:
      blur(18px);
  }

  .experience-header {
    margin-bottom:
      2.5rem;
  }

  .experience-eyebrow {
    margin:
      0;

    color:
      var(--accent);

    font-size:
      0.78rem;

    font-weight:
      650;

    letter-spacing:
      0.18em;

    text-transform:
      uppercase;
  }

  .experience-title {
    margin:
      0.35rem 0 0;

    color:
      var(--text-primary);

    font-size:
      clamp(
        1.8rem,
        3vw,
        2.4rem
      );

    font-weight:
      720;

    letter-spacing:
      -0.035em;
  }

  .experience-introduction {
    max-width:
      72rem;

    margin:
      1rem 0 0;

    color:
      var(--text-secondary);

    font-size:
      0.92rem;

    line-height:
      1.65rem;
  }

  .experience-list {
    display:
      flex;

    flex-direction:
      column;

    gap:
      2.5rem;
  }

  .experience-item {
    position:
      relative;

    margin-left:
      0.35rem;

    padding-left:
      1.75rem;

    border-left:
      2px solid
      color-mix(
        in srgb,
        var(--accent) 70%,
        var(--border-color)
      );
  }

  .experience-dot {
    position:
      absolute;

    top:
      0.45rem;

    left:
      -0.45rem;

    width:
      0.78rem;

    height:
      0.78rem;

    border:
      2px solid
      var(--background-elevated);

    border-radius:
      9999px;

    background:
      var(--accent);

    box-shadow:
      0 0 0 3px
      color-mix(
        in srgb,
        var(--accent) 12%,
        transparent
      );
  }

  .experience-top {
    display:
      flex;

    align-items:
      flex-start;

    justify-content:
      space-between;

    gap:
      1.5rem;
  }

  .experience-heading {
    min-width:
      0;
  }

  .experience-role {
    margin:
      0;

    color:
      var(--text-primary);

    font-size:
      1.18rem;

    font-weight:
      680;

    line-height:
      1.45rem;
  }

  .experience-company {
    margin:
      0.3rem 0 0;

    color:
      var(--text-secondary);

    font-size:
      0.88rem;

    font-weight:
      600;
  }

  .experience-client {
    margin:
      0.2rem 0 0;

    color:
      var(--accent);

    font-size:
      0.78rem;

    font-weight:
      550;
  }

  .experience-location {
    margin:
      0.2rem 0 0;

    color:
      var(--text-muted);

    font-size:
      0.75rem;
  }

  .experience-period {
    display:
      inline-flex;

    align-items:
      center;

    justify-content:
      center;

    flex-shrink:
      0;

    min-height:
      2rem;

    padding:
      0.4rem 0.75rem;

    border:
      1px solid
      var(--border-color);

    border-radius:
      9999px;

    background:
      var(--background-primary);

    color:
      var(--text-secondary);

    font-size:
      0.67rem;

    font-weight:
      650;

    letter-spacing:
      0.025em;

    white-space:
      nowrap;
  }

  .experience-description {
    display:
      flex;

    flex-direction:
      column;

    gap:
      0.7rem;

    margin:
      1.3rem 0 0;

    padding:
      0;

    list-style:
      none;
  }

  .experience-description-item {
    display:
      flex;

    align-items:
      flex-start;

    gap:
      0.75rem;

    color:
      var(--text-secondary);

    font-size:
      0.84rem;

    line-height:
      1.45rem;
  }

  .experience-bullet {
    width:
      0.38rem;

    height:
      0.38rem;

    margin-top:
      0.52rem;

    flex-shrink:
      0;

    border-radius:
      9999px;

    background:
      var(--accent);
  }

  .experience-tags {
    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      0.45rem;

    margin-top:
      1.25rem;
  }

  .experience-tag {
    display:
      inline-flex;

    align-items:
      center;

    min-height:
      1.8rem;

    padding:
      0.3rem 0.65rem;

    border:
      1px solid
      color-mix(
        in srgb,
        var(--accent) 20%,
        var(--border-color)
      );

    border-radius:
      9999px;

    background:
      color-mix(
        in srgb,
        var(--accent) 8%,
        var(--background-primary)
      );

    color:
      var(--accent);

    font-size:
      0.7rem;

    font-weight:
      550;

    line-height:
      1rem;

    transition:
      background-color 150ms ease,
      border-color 150ms ease,
      transform 150ms ease;
  }

  .experience-tag:hover {
    transform:
      translateY(-1px);

    border-color:
      color-mix(
        in srgb,
        var(--accent) 35%,
        var(--border-color)
      );

    background:
      color-mix(
        in srgb,
        var(--accent) 12%,
        var(--background-primary)
      );
  }

  @media (max-width: 768px) {
    .experience-top {
      flex-direction:
        column;

      gap:
        0.8rem;
    }

    .experience-period {
      align-self:
        flex-start;
    }

    .experience-introduction {
      font-size:
        0.86rem;

      line-height:
        1.55rem;
    }
  }

  @media (max-width: 640px) {
    .experience-section {
      padding:
        1.25rem;

      border-radius:
        1.5rem;
    }

    .experience-header {
      margin-bottom:
        2rem;
    }

    .experience-list {
      gap:
        2rem;
    }

    .experience-item {
      padding-left:
        1.35rem;
    }

    .experience-role {
      font-size:
        1.05rem;
    }

    .experience-description-item {
      font-size:
        0.78rem;

      line-height:
        1.35rem;
    }

    .experience-tag {
      font-size:
        0.66rem;
    }
  }

  @media (max-width: 430px) {
    .experience-section {
      padding:
        1rem;

      border-radius:
        1.25rem;
    }

    .experience-item {
      margin-left:
        0.25rem;

      padding-left:
        1.15rem;
    }

    .experience-period {
      white-space:
        normal;
    }

    .experience-tags {
      gap:
        0.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .experience-tag {
      transition:
        none;
    }

    .experience-tag:hover {
      transform:
        none;
    }
  }
</style>