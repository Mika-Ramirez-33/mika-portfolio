---
import {
  useTranslations,
} from '../i18n/utils';

const t = useTranslations(
  Astro.currentLocale
);

type TranslationKey =
  Parameters<typeof t>[0];

interface Contribution {
  roleKey: TranslationKey;
  organization: string;
  periodKey: TranslationKey;
  descriptionKey: TranslationKey;
  tags: string[];
  number: string;
}

const contributions: Contribution[] = [
  {
    number: '01',

    roleKey:
      'volunteering.innovak.role',

    organization:
      'Innovak',

    periodKey:
      'volunteering.innovak.period',

    descriptionKey:
      'volunteering.innovak.description',

    tags: [
      'IT Infrastructure',
      'Consulting',
      'Documentation',
      'Technology',
    ],
  },

  {
    number: '02',

    roleKey:
      'volunteering.soveetnik.role',

    organization:
      'Soveetnik',

    periodKey:
      'volunteering.soveetnik.period',

    descriptionKey:
      'volunteering.soveetnik.description',

    tags: [
      'Instructional Design',
      'Content Design',
      'Documentation',
      'Digital Education',
    ],
  },
];
---

<section
  id="volunteering"
  class="volunteering-section"
>
  <header class="volunteering-header">

    <div>
      <p class="volunteering-eyebrow">
        {t('volunteering.eyebrow')}
      </p>

      <h2 class="volunteering-title">
        {t('volunteering.title')}
      </h2>
    </div>

    <p class="volunteering-description">
      {t('volunteering.description')}
    </p>

  </header>

  <div class="volunteering-grid">
    {
      contributions.map((contribution) => (

        <article class="volunteering-card">

          <div class="volunteering-card-top">

            <span class="volunteering-number">
              {contribution.number}
            </span>

            <span class="volunteering-period">
              {t(contribution.periodKey)}
            </span>

          </div>

          <div class="volunteering-heading">

            <div
              class="volunteering-icon"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 21s-7-4.35-7-10a4 4 0 017-2.65A4 4 0 0119 11c0 5.65-7 10-7 10z"
                />
              </svg>
            </div>

            <div>
              <h3 class="volunteering-role">
                {t(contribution.roleKey)}
              </h3>

              <p class="volunteering-organization">
                {contribution.organization}
              </p>
            </div>

          </div>

          <p class="volunteering-card-description">
            {t(contribution.descriptionKey)}
          </p>

          <div class="volunteering-tags">
            {
              contribution.tags.map((tag) => (

                <span class="volunteering-tag">
                  {tag}
                </span>

              ))
            }
          </div>

        </article>

      ))
    }
  </div>
</section>

<style>
  .volunteering-section {
    padding:
      2rem;

    border:
      1px solid
      var(--border-color);

    border-radius:
      2rem;

    background:
      var(--background-elevated);

    box-shadow:
      0 20px 50px
      var(--shadow-color);

    backdrop-filter:
      blur(18px);

    -webkit-backdrop-filter:
      blur(18px);
  }

  .volunteering-header {
    display:
      flex;

    align-items:
      flex-end;

    justify-content:
      space-between;

    gap:
      2rem;

    margin-bottom:
      2rem;
  }

  .volunteering-eyebrow {
    margin:
      0;

    color:
      var(--accent);

    font-size:
      0.78rem;

    font-weight:
      650;

    letter-spacing:
      0.18em;

    text-transform:
      uppercase;
  }

  .volunteering-title {
    margin:
      0.35rem 0 0;

    color:
      var(--text-primary);

    font-size:
      clamp(
        1.8rem,
        3vw,
        2.4rem
      );

    font-weight:
      720;

    letter-spacing:
      -0.035em;
  }

  .volunteering-description {
    max-width:
      38rem;

    margin:
      0;

    color:
      var(--text-secondary);

    font-size:
      0.92rem;

    line-height:
      1.55rem;
  }

  .volunteering-grid {
    display:
      grid;

    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );

    gap:
      1rem;
  }

  .volunteering-card {
    position:
      relative;

    display:
      flex;

    flex-direction:
      column;

    min-width:
      0;

    padding:
      1.4rem;

    border:
      1px solid
      var(--border-color);

    border-radius:
      1.4rem;

    background:
      var(--background-secondary);

    overflow:
      hidden;

    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease,
      background-color 180ms ease;
  }

  .volunteering-card::before {
    content:
      '';

    position:
      absolute;

    top:
      0;

    left:
      0;

    width:
      100%;

    height:
      3px;

    background:
      linear-gradient(
        90deg,
        var(--accent),
        transparent
      );

    opacity:
      0.75;
  }

  .volunteering-card:hover {
    transform:
      translateY(-3px);

    border-color:
      color-mix(
        in srgb,
        var(--accent) 28%,
        var(--border-color)
      );

    box-shadow:
      0 16px 34px
      var(--shadow-color);
  }

  .volunteering-card-top {
    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    gap:
      1rem;
  }

  .volunteering-number {
    color:
      var(--accent);

    font-size:
      0.7rem;

    font-weight:
      750;

    letter-spacing:
      0.08em;
  }

  .volunteering-period {
    display:
      inline-flex;

    align-items:
      center;

    justify-content:
      center;

    min-height:
      1.9rem;

    padding:
      0.35rem
      0.65rem;

    border:
      1px solid
      var(--border-color);

    border-radius:
      9999px;

    background:
      var(--background-primary);

    color:
      var(--text-muted);

    font-size:
      0.65rem;

    font-weight:
      600;

    letter-spacing:
      0.025em;

    white-space:
      nowrap;
  }

  .volunteering-heading {
    display:
      flex;

    align-items:
      center;

    gap:
      0.9rem;

    margin-top:
      1.25rem;
  }

  .volunteering-icon {
    display:
      flex;

    width:
      3rem;

    height:
      3rem;

    flex-shrink:
      0;

    align-items:
      center;

    justify-content:
      center;

    border:
      1px solid
      color-mix(
        in srgb,
        var(--accent) 20%,
        var(--border-color)
      );

    border-radius:
      1rem;

    background:
      color-mix(
        in srgb,
        var(--accent) 9%,
        transparent
      );

    color:
      var(--accent);
  }

  .volunteering-icon svg {
    width:
      1.4rem;

    height:
      1.4rem;
  }

  .volunteering-role {
    margin:
      0;

    color:
      var(--text-primary);

    font-size:
      1.05rem;

    font-weight:
      680;

    line-height:
      1.4rem;
  }

  .volunteering-organization {
    margin:
      0.25rem 0 0;

    color:
      var(--accent);

    font-size:
      0.8rem;

    font-weight:
      600;
  }

  .volunteering-card-description {
    margin:
      1.2rem 0 0;

    color:
      var(--text-secondary);

    font-size:
      0.82rem;

    line-height:
      1.45rem;
  }

  .volunteering-tags {
    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      0.45rem;

    margin-top:
      auto;

    padding-top:
      1.25rem;
  }

  .volunteering-tag {
    display:
      inline-flex;

    align-items:
      center;

    min-height:
      1.8rem;

    padding:
      0.3rem
      0.65rem;

    border:
      1px solid
      color-mix(
        in srgb,
        var(--accent) 18%,
        var(--border-color)
      );

    border-radius:
      9999px;

    background:
      color-mix(
        in srgb,
        var(--accent) 7%,
        var(--background-primary)
      );

    color:
      var(--text-secondary);

    font-size:
      0.68rem;

    font-weight:
      550;

    line-height:
      1rem;

    transition:
      border-color 150ms ease,
      background-color 150ms ease,
      color 150ms ease;
  }

  .volunteering-tag:hover {
    border-color:
      color-mix(
        in srgb,
        var(--accent) 32%,
        var(--border-color)
      );

    background:
      color-mix(
        in srgb,
        var(--accent) 11%,
        var(--background-primary)
      );

    color:
      var(--accent);
  }

  @media (max-width: 900px) {
    .volunteering-header {
      flex-direction:
        column;

      align-items:
        flex-start;

      gap:
        0.75rem;
    }

    .volunteering-description {
      max-width:
        100%;
    }

    .volunteering-grid {
      grid-template-columns:
        1fr;
    }
  }

  @media (max-width: 640px) {
    .volunteering-section {
      padding:
        1.25rem;

      border-radius:
        1.5rem;
    }

    .volunteering-card {
      padding:
        1.15rem;
    }

    .volunteering-heading {
      align-items:
        flex-start;
    }

    .volunteering-role {
      font-size:
        1rem;
    }

    .volunteering-card-description {
      font-size:
        0.78rem;

      line-height:
        1.38rem;
    }
  }

  @media (max-width: 430px) {
    .volunteering-section {
      padding:
        1rem;

      border-radius:
        1.25rem;
    }

    .volunteering-card-top {
      align-items:
        flex-start;

      flex-direction:
        column;

      gap:
        0.6rem;
    }

    .volunteering-period {
      white-space:
        normal;
    }

    .volunteering-heading {
      gap:
        0.7rem;
    }

    .volunteering-icon {
      width:
        2.7rem;

      height:
        2.7rem;
    }

    .volunteering-tags {
      gap:
        0.35rem;
    }

    .volunteering-tag {
      font-size:
        0.65rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .volunteering-card,
    .volunteering-tag {
      transition:
        none;
    }

    .volunteering-card:hover {
      transform:
        none;
    }
  }
</style>